# Copy this file to .env and fill in real values before running the app

# Database — SQLite is used by default for zero-config local dev.
# For production, swap to Postgres, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/econnect"
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# OTP (mocked to console in dev — replace with a real SMS/email provider in production)
OTP_EXPIRY_MINUTES=10

# Admin bootstrap (used by prisma/seed.js)
ADMIN_EMAIL="admin@econnect.co.sz"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_PHONE="+26876000000"